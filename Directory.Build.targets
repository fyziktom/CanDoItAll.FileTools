<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageReadmeFile)' == ''">
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <_UseRepositoryPackageReadme>true</_UseRepositoryPackageReadme>
  </PropertyGroup>
  <ItemGroup Condition="'$(_UseRepositoryPackageReadme)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Pack="true"
          PackagePath="\"
          Link="README.md" />
  </ItemGroup>
</Project>
