@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="@SurfaceClass"
     hidden="@(Context.IsEmpty || interopError is not null || !isReady)"
     aria-hidden="@(Context.IsEmpty || interopError is not null || !isReady)"
     data-testid="@SurfaceTestId">
    @if (TargetFrame is null)
    {
        @TargetContent
    }
    else
    {
        @TargetFrame(new FileObjectViewTargetFrameContext(Kind, TargetContent))
    }
</div>

@if (Context.IsEmpty)
{
    <div class="cdi-ft-object-state" role="status" data-testid="interaction-empty-file">This file is empty.</div>
}
else if (interopError is not null)
{
    <div class="cdi-ft-object-state" role="status" data-testid="interaction-object-fallback">
        This browser could not prepare the file preview. Use a host-provided action to open or download it.
    </div>
}
@code {
    [Parameter, EditorRequired]
    public FileInteractionRenderContext Context { get; set; } = default!;

    [Parameter]
    public FileObjectViewKind Kind { get; set; }

    [Parameter]
    public RenderFragment<FileObjectViewTargetFrameContext>? TargetFrame { get; set; }

    private ElementReference target;
    private ElementReference activeTarget;
    private FileObjectUrlInterop? interop;
    private bool contentChanged;
    private bool disposed;
    private bool isApplying;
    private bool isReady;
    private bool hasActiveTarget;
    private string? interopError;
    private FileObjectContentStamp? previousStamp;

    private string EffectiveMediaType => Context.MediaType
        ?? (Kind == FileObjectViewKind.Pdf ? "application/pdf" : "application/octet-stream");

    private string SurfaceClass => Kind switch
    {
        FileObjectViewKind.Image => "cdi-ft-object-surface cdi-ft-object-surface--image",
        FileObjectViewKind.Pdf => "cdi-ft-object-surface",
        _ => "cdi-ft-object-surface cdi-ft-object-surface--browser"
    };

    private string SurfaceTestId => Kind switch
    {
        FileObjectViewKind.Image => "interaction-image-view",
        FileObjectViewKind.Pdf => "interaction-pdf-view",
        _ => "interaction-browser-view"
    };

    private RenderFragment TargetContent => @<text>
        @if (Kind == FileObjectViewKind.Image)
        {
            <img @key="previousStamp"
                 @ref="target"
                 alt="@Context.Request.FileName"
                 @onload="HandleTargetLoaded"
                 @onerror="HandleTargetError" />
        }
        else if (Kind == FileObjectViewKind.Pdf)
        {
            <object @key="previousStamp"
                    @ref="target"
                    type="@EffectiveMediaType"
                    aria-label="@Context.Request.FileName"
                    @onload="HandleTargetLoaded"
                    @onerror="HandleTargetError">
                <div class="cdi-ft-object-state">
                    This browser cannot display the file. Use a host-provided action to open or download it.
                </div>
            </object>
        }
        else
        {
            <iframe @key="previousStamp"
                    @ref="target"
                    title="@Context.Request.FileName"
                    sandbox=""
                    referrerpolicy="no-referrer"
                    @onload="HandleTargetLoaded"
                    @onerror="HandleTargetError">
            </iframe>
        }
    </text>;

    protected override void OnParametersSet()
    {
        if (!Enum.IsDefined(Kind))
        {
            throw new InvalidOperationException("Only image, PDF, and sandboxed browser object URL viewers are supported.");
        }

        var stamp = new FileObjectContentStamp(
            Context.Request.File,
            Context.EditRevision,
            Context.Content.Length,
            Context.Content,
            Context.Request.ContentRevision,
            EffectiveMediaType,
            Kind);
        contentChanged = previousStamp != stamp;
        if (contentChanged)
        {
            interopError = null;
            isApplying = true;
            isReady = false;
        }

        previousStamp = stamp;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var targetChanged = hasActiveTarget && !target.Equals(activeTarget);
        if (interopError is not null || (!firstRender && !contentChanged && !targetChanged))
        {
            return;
        }

        if (Context.IsEmpty)
        {
            contentChanged = false;
            isApplying = false;
            isReady = false;
            if (interop is not null)
            {
                await interop.RevokeAsync(hasActiveTarget ? activeTarget : target);
                hasActiveTarget = false;
            }

            return;
        }

        interop ??= new FileObjectUrlInterop(JS);
        contentChanged = false;
        isApplying = true;
        var appliedStamp = previousStamp;
        var appliedTarget = target;
        try
        {
            if (hasActiveTarget)
            {
                await interop.RevokeAsync(activeTarget);
                hasActiveTarget = false;
            }

            var applied = await interop.ApplyAsync(
                appliedTarget,
                Context.Content,
                EffectiveMediaType,
                Kind == FileObjectViewKind.Pdf ? "data" : "src");
            if (!applied || disposed || appliedStamp != previousStamp)
            {
                return;
            }

            activeTarget = appliedTarget;
            hasActiveTarget = true;
            isApplying = false;
            isReady = Kind is FileObjectViewKind.Pdf or FileObjectViewKind.Browser;
            StateHasChanged();
        }
        catch (Exception exception) when (FileObjectUrlInterop.IsExpectedFailure(exception))
        {
            if (disposed || appliedStamp != previousStamp)
            {
                return;
            }

            interopError = exception.Message;
            isApplying = false;
            isReady = false;
            if (!disposed && exception is not JSDisconnectedException)
            {
                StateHasChanged();
            }
        }
    }

    private void HandleTargetLoaded()
    {
        if (!disposed
            && !Context.IsEmpty
            && !isApplying
            && interopError is null)
        {
            isReady = true;
        }
    }

    private void HandleTargetError()
    {
        if (!disposed && !isApplying)
        {
            isReady = false;
            interopError = Kind switch
            {
                FileObjectViewKind.Image => "The browser could not decode this image.",
                FileObjectViewKind.Pdf => "The browser could not display this PDF.",
                _ => "The browser could not display this file type."
            };
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (interop is not null)
        {
            await interop.DisposeAsync(hasActiveTarget ? activeTarget : target);
            hasActiveTarget = false;
        }
    }

}
