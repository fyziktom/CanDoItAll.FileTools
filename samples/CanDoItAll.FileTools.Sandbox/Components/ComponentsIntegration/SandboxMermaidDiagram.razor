@namespace CanDoItAll.FileTools.Sandbox.Components
@using CanDoItAll.Components.Mermaid

<MermaidDiagram Source="@Source"
                Options="StrictOptions"
                PanZoomEnabled="false"
                ShowControls="false"
                Class="sandbox-mermaid__diagram-root"
                Style="block-size: 100%; --cda-mermaid-height: 100%; --cda-mermaid-min-height: 0px; --cda-zoom-pan-min-height: 0px;"
                Rendered="HandleRenderedAsync"
                Error="HandleErrorAsync"
                data-testid="sandbox-mermaid-diagram" />

@code {
    private static readonly MermaidDiagramOptions StrictOptions = new()
    {
        SecurityLevel = "strict",
        HtmlLabels = false,
        FlowchartUseMaxWidth = true
    };

    /// <summary>Mermaid source rendered through the real CanDoItAll.Components wrapper in strict mode.</summary>
    [Parameter, EditorRequired]
    public string Source { get; set; } = string.Empty;

    /// <summary>Receives a short render or error status line for the sandbox evidence strip.</summary>
    [Parameter]
    public EventCallback<string> StatusChanged { get; set; }

    private Task HandleRenderedAsync(MermaidRenderResult result)
        => StatusChanged.InvokeAsync(
            $"Rendered {result.NodeCount} node(s) with strict security; viewport owned by FileZoomPanFrame.");

    private Task HandleErrorAsync(MermaidRenderError error)
        => StatusChanged.InvokeAsync($"Mermaid error: {error.Message} ({error.LocationText})");
}
